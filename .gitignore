__pycache__/
*.pyc
.DS_Store
.claude/
logs/
results/*
!results/backtest/
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/

# macOS app build artifacts (SwiftPM .build, assembled .app bundles, PyInstaller freeze)
.build/
*.app/
*.dmg
*.xcuserstate
# frozen engine binary + generated spec (rebuild via freeze_engine.sh — ~190 MB)
gim-engine
gim-engine.spec
.venv/
venv/
data/agent_state_pipeline/cache/
dashboard.html
decision_brief.md
*_dashboard.html
*_brief.md
*_evaluation.json
ui/

# Test fixtures must always be tracked, even if they match the artifact patterns above.
!tests/fixtures/
!tests/fixtures/**

# stray sandbox lock files
.lock

# scratch experiment scripts (sandbox FUSE cannot unlink from worktree)
_*.py
# ...but never shadow real Python package files (this rule otherwise silently drops
# every __init__.py / __main__.py from a fresh `git add -A` in a brand-new repo).
!**/__init__.py
!**/__main__.py

# local archive of removed change-history / superseded docs (not tracked)
_archive_local/

# bulk external source data (re-fetch via scripts/ingest_external_data.py + download_ucdp.py)
data/external/raw/

# LaTeX build artifacts (keep .tex/.bib/.pdf)
paper/*.aux
paper/*.log
paper/*.blg
paper/*.bbl
paper/*.out
paper/*.toc
paper/*.fdb_latexmk
paper/*.fls
paper/*.xdv
paper/figures/*.aux
paper/figures/*.log

# Removed from version control for a cleaner remote, but kept on local disk:
#   - misc/assets/credit_map: dead duplicate of vendor/leaflet + data/world_countries.geojson
#   - process/meta docs not part of the published academic artifact
misc/assets/
paper/REVISION_PLAN.md
docs/FINALIZATION_REPORT.md

# Paper materials — kept locally, not part of the public repo (companion to the publication)
# Exception: Paper/revision/ is tracked — validation scripts and their JSON results are
# code/data availability material for the submission, not manuscript sources.
# (core.ignorecase is on here, so the lowercase rule also matches Paper/ — keep the
# negation after both so it is not overridden.)
Paper/*
paper/*
!Paper/revision/
# Figures are tracked: scripts/make_paper_figures.py regenerates them from committed
# model output, and the public release ships that generator, so its output directory
# belongs with it.
!Paper/figures/
# The manuscript itself ships with the release from 20.1 on. Only the canonical version:
# the older drafts (gim_paper.tex, _clean, _condensed) and the Russian translation predate
# the 20.1 validation repairs and would contradict the numbers in this one.
!Paper/gim_paper_v2_8K.tex
!Paper/gim_paper_v2_8K.pdf
!Paper/references_v2.bib
!Paper/cas-sc.cls
!Paper/cas-common.sty

# Paper scratch screenshots / review markups (not part of the paper; keep fig2-fig5 sources)
paper/chk-*.png
paper/vchk-*.png
paper/nv-*.png
paper/pg-*.png
paper/hi-*.png
paper/sec-*.png
paper/figures/fig1_test.*
paper/figures/fig1_prev*.png

# Manuscript backups (kept locally, out of the remote)
paper/*_backup.tex
paper/*_ORIGINAL*.tex
data/blocks/RUS/raw/territories/ne_admin1_*.geojson
data/blocks/RUS/raw/territories/cie/
lib/gim
